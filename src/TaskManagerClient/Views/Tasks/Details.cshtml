@model TaskManagerClient.Models.TaskItem

@{
    ViewData["Title"] = "Просмотр задачи";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-card-text me-2"></i>Задача #@Model.Id</h4>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">ID:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Название:</dt>
                    <dd class="col-sm-8 fw-bold fs-5">@Model.Title</dd>

                    <dt class="col-sm-4 text-muted">Описание:</dt>
                    <dd class="col-sm-8 text-secondary">@Model.Description</dd>

                    <dt class="col-sm-4 text-muted">Статус:</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success fs-6"><i class="bi bi-check2-circle me-1"></i>Выполнено</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6"><i class="bi bi-clock me-1"></i>В работе</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Назад к списку
                </a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                        <i class="bi bi-pencil me-1"></i>Изменить
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
